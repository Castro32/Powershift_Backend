# ── MongoDB ──────────────────────────────────────────────────────────────
# Full connection string from MongoDB Atlas (or self-hosted). Include the
# database name at the end, e.g. mongodb+srv://user:pass@cluster.mongodb.net/powershift
MONGODB_URI=

# ── Stripe ───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Frontend ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://powershift.ae

# ── Mailchimp ────────────────────────────────────────────────────────────
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_DC=

# ── Resend (admin payment-notification emails) ──────────────────────────
RESEND_API_KEY=
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
ADMIN_EMAIL_3=
ADMIN_EMAIL_4=

# ── Admin portal login ───────────────────────────────────────────────────
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# ── Ebook file ───────────────────────────────────────────────────────────
EBOOK_CLOUDINARY_URL=

PORT=3001
